# Copy this file to `.env` and fill in the two keys:
#
#   cp .env.example .env
#
# Both services bill per call. A full 1,000-tweet run costs roughly $0.40 in
# total — see "What a run costs" in the README before pointing this at traffic.

# ── Required ────────────────────────────────────────────────────────────────

# AIsa — reads the website (Tavily crawl) and searches X (advanced search).
# Get a key at https://aisa.one
AISA_API_KEY=

# Vercel AI Gateway — the language model that writes the profile and the
# searches, and jev, which makes the call on every tweet.
# Create a key at https://vercel.com/dashboard/ai-gateway/api-keys
# Not needed on Vercel itself: deployments authenticate to the gateway by OIDC.
AI_GATEWAY_API_KEY=

# ── Optional ────────────────────────────────────────────────────────────────

# Model that writes the profile and the search queries. Any AI Gateway
# language model id works.
# LLM_MODEL=anthropic/claude-sonnet-5

# Evaluation model that scores each tweet.
# JEV_MODEL=typesafe-ai/jev

# How many tweets one run reads. Lower it for cheap experiments.
# RUN_TWEET_TARGET=1000

# Stop starting new paid work once a day's spend (models + data) passes this.
# Held in process memory, so on serverless it is per instance — a guard rail,
# not a hard limit. See "Before you put it on the internet" in the README.
# DAILY_BUDGET_USD=5
