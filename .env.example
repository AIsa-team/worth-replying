# Copy to .env.local. All variables are server-only; never use NEXT_PUBLIC_*.
# One stable OAuth client must be registered by the operator with the exact
# callback below. The app never creates clients or uses a shared AIsa key.
APP_ORIGIN=http://localhost:3000
AISA_OAUTH_CLIENT_ID=
# Set only for a confidential client registered with client_secret_basic.
# Leave unset for a public PKCE client with token_endpoint_auth_method=none.
# AISA_OAUTH_CLIENT_SECRET=

# openssl rand -base64 32; stable across instances, rotation signs everyone out.
AISA_AUTH_SECRET=

# WEBSITE pays for profile/query models and jev. Locally required; Vercel uses
# deployment OIDC with AI Gateway enabled for the team.
AI_GATEWAY_API_KEY=

# USER pays for AIsa website reads and X searches, including volume samples.
# Scopes: openid profile email. No offline_access or user:org:read.
# Register http://localhost:3000/auth/callback and your exact HTTPS deployment
# callback at AIsa/Clerk, then configure all variables in that environment.

# LLM_MODEL=anthropic/claude-sonnet-5
# JEV_MODEL=typesafe-ai/jev
# RUN_TWEET_TARGET=1000
# Approximate per-process guard for each login and separately for site models;
# not a hard cross-instance limit or a replacement for real account controls.
# DAILY_BUDGET_USD=5
